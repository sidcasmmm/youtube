# Required for real LLM script + OpenAI TTS (+ optional Whisper cut alignment)
# Never commit the real key — copy to .env and fill in
OPENAI_API_KEY=sk-...

# Stock B-roll — free API keys; prefer Pexels, Pixabay as fallback
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional overrides
# OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Operator UI (npm run ui) — default 4173
# PORT=4173

# --- M4 YouTube Shorts upload (optional) ---
# See docs/youtube-oauth-setup.md
# 1) Create Google Cloud project + enable YouTube Data API v3
# 2) Create OAuth client; redirect URI: http://localhost:8765/oauth2callback
# 3) Put client id/secret below, then: npm run youtube:auth
# 4) Paste refresh token here (never commit .env)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_REDIRECT_URI=http://localhost:8765/oauth2callback
# Default privacy for spike uploads (private | unlisted | public)
# YOUTUBE_PRIVACY_STATUS=private
