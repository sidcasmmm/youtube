{
  "name": "@shorts/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "shorts-generate": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "npm run build -w @shorts/prompts && tsx src/cli.ts"
  },
  "dependencies": {
    "@shorts/compose": "*",
    "@shorts/prompts": "*",
    "dotenv": "^16.4.7",
    "openai": "^4.89.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}