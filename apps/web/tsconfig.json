{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@shorts/pipeline": ["../../packages/pipeline/src/index.ts"],
      "@shorts/prompts": ["../../packages/prompts/src/index.ts"],
      "@shorts/compose": ["../../packages/compose/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
