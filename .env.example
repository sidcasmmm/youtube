# Required for real LLM script + OpenAI TTS (+ optional Whisper cut alignment)
# Never commit the real key — copy to .env and fill in
OPENAI_API_KEY=sk-...

# Stock B-roll — free API keys; prefer Pexels, Pixabay as fallback
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional overrides
# OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Operator UI (npm run ui) — default 4173
# PORT=4173
